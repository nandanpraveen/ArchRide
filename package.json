{
  "name": "archride",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "db:types": "supabase gen types --linked --lang typescript --schema public > src/lib/supabase/database.types.ts",
    "transit:ingest": "node --import tsx scripts/transit/ingest.ts",
    "transit:probe": "node --import tsx scripts/transit/probe.ts",
    "test:transit": "node --import tsx --test tests/transit/*.test.ts",
    "test:classes": "node --import tsx --test tests/classes/*.test.ts",
    "test:notifications": "node --import tsx --test tests/notifications/*.test.ts",
    "push:build": "node scripts/build-push.mjs",
    "db:types:local": "node --import tsx scripts/transit/generate-types.ts",
    "transit:edge:build": "node scripts/transit/build-edge.mjs",
    "transit:hosted:smoke": "node --env-file=.env.local --import tsx scripts/transit/hosted-smoke.ts",
    "campus:fetch": "node --import tsx scripts/campus/import.ts --fetch",
    "transit:evaluate": "node --import tsx scripts/transit/evaluate.ts",
    "test:planner": "node --import tsx --test tests/planner/*.test.ts",
    "test:personal": "node --import tsx --test tests/personal/*.test.ts",
    "predictor:replay": "node --import tsx scripts/transit/predictor-replay.ts",
    "test:parking": "node --import tsx --test tests/parking/*.test.ts",
    "build:pages": "NEXT_PUBLIC_BASE_PATH=/archride next build --webpack",
    "test:export": "playwright test --config playwright.export.config.ts"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@mui/material-nextjs": "9.5.0",
    "@supabase/supabase-js": "2.117.3",
    "csv-parse": "7.0.3",
    "fflate": "0.8.3",
    "gtfs-realtime-bindings": "2.2.0",
    "maplibre-gl": "6.15.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@playwright/test": "1.64.0",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24 <25"
  }
}
