NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# GitHub Pages project path. Leave blank for local development.
NEXT_PUBLIC_BASE_PATH=
# Only for an intentional Supabase provider-config push. The app never reads this secret.
# Obtain it from the provider's secure configuration; never use a NEXT_PUBLIC_ prefix.
ARCHRIDE_GOOGLE_CLIENT_SECRET=
# Server-only jobs may later require SUPABASE_SECRET_KEY. Never prefix it NEXT_PUBLIC_.

# Browser push: generate server-only keys with node scripts/create-push-secrets.mjs.
# Deploy its private env file to Edge Function secrets; see docs/browser-notifications.md.
# PUSH_VAPID_PUBLIC_KEY / PUSH_VAPID_PRIVATE_KEY / PUSH_VAPID_SUBJECT / PUSH_JOB_TOKEN

# Only the server-side transit CLI uses these. Use a direct/SESSION pooler URI with TLS.
# Store production values in the worker's secret manager, never in client env vars.
TRANSIT_DATABASE_URL=
# Set true only after recording authorized use and approved polling limits.
TRANSIT_SOURCE_APPROVED=false
